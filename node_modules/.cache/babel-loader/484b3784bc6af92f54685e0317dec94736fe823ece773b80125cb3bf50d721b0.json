{"ast":null,"code":"export default {\n  name: 'AlreadyAuthentifier',\n  data: function data() {\n    return {\n      nom: 'Invité'\n    };\n  },\n  methods: {\n    deconnect: function deconnect() {\n      this.$store.commit('setAuthentifier', false);\n      this.$store.commit('setAdmin', false);\n    }\n  }\n};","map":{"version":3,"names":["name","data","nom","methods","deconnect","$store","commit"],"sources":["src/components/AlreadyAuthentifier.vue"],"sourcesContent":["<template>\n    <div id=\"formulaire-authentification\">\n        <h4 id=\"nom-authentifier\">Bienvenue {{ nom }}</h4><br>\n        <h5>Vous êtes déjà connecté</h5>\n        <div>\n            <button id=\"change-mdp\">Changer mot de passe</button>\n            <button id=\"deconnect\" @click=\"deconnect\">Déconnexion</button>\n        </div>\n    </div>\n</template>\n\n<script>\nexport default {\n    name: 'AlreadyAuthentifier',\n    data() {\n        return {\n            nom : 'Invité',\n        }\n    },\n    methods: {\n        deconnect() {\n            this.$store.commit('setAuthentifier', false);\n            this.$store.commit('setAdmin', false);\n        },\n    },\n}\n</script>\n\n<style scoped>\n\nbutton {\n    width: 30%;\n    height: 30px;\n    border-radius: 5px;\n    border: 1px solid;\n    margin-bottom: 10px;\n    background-color: rgb(238, 103, 250);\n    cursor: pointer;\n    border-color: rgb(238, 103, 250);\n    color: rgb(88, 3, 88);\n}\n\n</style>"],"mappings":"AAYA;EACAA,IAAA;EACAC,IAAA,WAAAA,KAAA;IACA;MACAC,GAAA;IACA;EACA;EACAC,OAAA;IACAC,SAAA,WAAAA,UAAA;MACA,KAAAC,MAAA,CAAAC,MAAA;MACA,KAAAD,MAAA,CAAAC,MAAA;IACA;EACA;AACA"},"metadata":{},"sourceType":"module","externalDependencies":[]}