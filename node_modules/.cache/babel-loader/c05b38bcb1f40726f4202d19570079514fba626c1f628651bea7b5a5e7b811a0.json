{"ast":null,"code":"export default {\n  name: 'PrestatairesList',\n  props: {\n    prestataires: {\n      type: Array,\n      default: () => [{\n        nom: 'Prestataire 1',\n        id: 1\n      }, {\n        nom: 'Prestataire 2',\n        id: 2\n      }, {\n        nom: 'Prestataire 3',\n        id: 3\n      }]\n    }\n  }\n};","map":{"version":3,"names":["name","props","prestataires","type","Array","default","nom","id"],"sources":["src/components/PrestatairesList.vue"],"sourcesContent":["<template>\n    <div class=\"prestataires\">\n        <h1>Prestataires</h1>\n        <div class=\"prestataires-box\">\n            <div class=\"prestataires-cards\">\n                <div class=\"prestataires-card\" v-for=\"prestataire in prestataires\" :key=\"prestataire.id\">\n                    <div class=\"prestataires-photo\">\n                        <img src=\"../assets/logo.png\" alt=\"\">\n                    </div>\n                    <div class=\"prestataires-description\">\n                        <router-link :to=\"{ name: 'PrestataireView', params: { id: prestataire.id } }\">\n                            {{ prestataire.nom }}\n                        </router-link>\n                    </div>\n                </div>\n            </div>\n            <div class=\"prestataires-chips\">\n                <button class=\"chip-1 chip\"></button>\n                <button class=\"chip-2 chip\"></button>\n                <button class=\"chip-3 chip\"></button>\n            </div>\n        </div>\n    </div>\n</template>\n\n<script>\nexport default{\n    name: 'PrestatairesList',\n    props: {\n        prestataires: {\n            type: Array,\n            default: () => [{nom: 'Prestataire 1', id: 1}, {nom: 'Prestataire 2', id: 2}, {nom: 'Prestataire 3', id: 3}]\n        }\n    }\n}\n</script>\n\n<style scoped>\n.prestataires-box{\n    width: 60%;\n    display: block;\n    padding-left: 20%;\n}\n.prestataires-cards{\n    width: auto;\n    display: block;\n}\n.prestataires-