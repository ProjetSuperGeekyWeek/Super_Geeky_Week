{"ast":null,"code":"var _this = this;\nimport \"core-js/modules/es.array.push.js\";\nimport FormulaireAuthentification from '@/components/FormulaireAuthentification.vue';\nexport default {\n  name: 'AuthentificationView',\n  data: function data() {\n    return {\n      email: '',\n      password: '',\n      authentifier: false,\n      admin: false\n    };\n  },\n  components: {\n    FormulaireAuthentification: FormulaireAuthentification\n  },\n  methods: {\n    authentification: function authentification() {\n      this.email = session.email;\n      this.password = session.password;\n      this.authentifier = this.enregistrer(this.email, this.password);\n      session.authentifier = this.authentifier;\n      if (this.authentifier) {\n        this.admin = this.verifAdmin(this.email, this.password);\n        session.admin = this.admin;\n        if (this.admin) {\n          // this.$router.push('/admin');\n          this.$router.push('/services');\n        } else {\n          this.$router.push('/accueil');\n        }\n      }\n    }\n  },\n  computed: {\n    \"function\": function _function() {\n      _this.authentification();\n    }\n  }\n};","map":{"version":3,"names":["FormulaireAuthentification","name","data","email","password","authentifier","admin","components","methods","authentification","session","enregistrer","verifAdmin","$router","push","computed","_function","_this"],"sources":["src/views/AuthentificationView.vue"],"sourcesContent":["<template>\n    <!-- \n        directe page authentification\n        (+ option changer mot de passe)\n        quand authentifié, redirection vers page d'accueil\n    -->\n    <div class=\"authentification\">\n        <div class=\"cadre-authentification\" v-show=\"!authentifier\">\n            <div class=\"cadre-image\">\n                <img id=\"image-authentification\" src=\"../assets/image_connexion.jpg\" alt=\"Image authentification\">\n            </div>\n            <FormulaireAuthentification/>\n        </div>\n    </div>\n</template>\n\n<script>\n    import FormulaireAuthentification from '@/components/FormulaireAuthentification.vue';\n\n    export default {\n        name: 'AuthentificationView',\n        data() {\n            return {\n                email: '',\n                password: '',\n                authentifier: false,\n                admin: false\n            }\n        },\n        components: {\n            FormulaireAuthentification\n        },\n        methods: {\n            authentification() {\n                this.email = session.email;\n                this.password = session.password;\n                this.authentifier = this.enregistrer(this.email, this.password);\n                session.authentifier = this.authentifier;\n                if(this.authentifier) {\n                    this.admin = this.verifAdmin(this.email, this.password);\n                    session.admin = this.admin;\n                    if(this.admin) {\n                        // this.$router.push('/admin');\n                        this.$router.push('/services');\n                    } else {\n                        this.$router.push('/accueil');\n                    }\n                }\n            }\n\n\n        },\n        computed: {\n            function : () => {\n                this.authentification();\n            }\n        }\n    }\n</script>\n\n<style scoped>\n\n.authentification {\n    background-color: rgb(48, 15, 65);\n    height: 100vh;\n    width: 100vw;\n    padding-top: 10vh;\n    backdrop-filter: blur(0.5rem);\n}\n\n.cadre-authentification {\n    background-color: mediumpurple;\n    border-radius: 10px;\n    height: 70vh;\n    width: 50vw;\n    margin: auto;\n    border: 2px solid palevioletred;\n    filter: drop-shadow(0 0 10rem palevioletred);\n}\n\n.cadre-image {\n    border-radius: 10px 10px 0 0;\n    height: 70%;\n    width: 100%;\n    overflow: hidden;\n}\n\n#image-authentification {\n    border-radius: 10px 10px 0 0;\n    height: 100%;\n    width: 100%;\n    object-fit: cover;\n}\n\n</style>\n"],"mappings":";;AAiBA,OAAAA,0BAAA;AAEA;EACAC,IAAA;EACAC,IAAA,WAAAA,KAAA;IACA;MACAC,KAAA;MACAC,QAAA;MACAC,YAAA;MACAC,KAAA;IACA;EACA;EACAC,UAAA;IACAP,0BAAA,EAAAA;EACA;EACAQ,OAAA;IACAC,gBAAA,WAAAA,iBAAA;MACA,KAAAN,KAAA,GAAAO,OAAA,CAAAP,KAAA;MACA,KAAAC,QAAA,GAAAM,OAAA,CAAAN,QAAA;MACA,KAAAC,YAAA,QAAAM,WAAA,MAAAR,KAAA,OAAAC,QAAA;MACAM,OAAA,CAAAL,YAAA,QAAAA,YAAA;MACA,SAAAA,YAAA;QACA,KAAAC,KAAA,QAAAM,UAAA,MAAAT,KAAA,OAAAC,QAAA;QACAM,OAAA,CAAAJ,KAAA,QAAAA,KAAA;QACA,SAAAA,KAAA;UACA;UACA,KAAAO,OAAA,CAAAC,IAAA;QACA;UACA,KAAAD,OAAA,CAAAC,IAAA;QACA;MACA;IACA;EAGA;EACAC,QAAA;IACA,qBAAAC,UAAA;MACAC,KAAA,CAAAR,gBAAA;IACA;EACA;AACA"},"metadata":{},"sourceType":"module","externalDependencies":[]}