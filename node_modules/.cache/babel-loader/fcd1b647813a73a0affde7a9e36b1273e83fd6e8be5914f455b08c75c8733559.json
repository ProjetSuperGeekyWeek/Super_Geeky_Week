er {\n  filter: drop-shadow(0px 0px 10px rgb(101, 216, 235));\n}\n\nnav a.router-link-exact-active {\n  color: #83fffb;\n}\n\n.authentification-nav a.router-link-exact-active {\n  filter: drop-shadow(0px 0px 10px #65d8eb);\n}\n</style>\n"],"mappings":";AAyBA,SAAAA,QAAA;AAEA;EACAC,IAAA;EACAC,IAAA,WAAAA,KAAA;IACA;MACAC,QAAA;MACAC,MAAA;IACA;EACA;EACAC,OAAA;IACAC,iBAAA,WAAAA,kBAAA;MACA,KAAAH,QAAA,SAAAA,QAAA;IACA;IACAI,OAAA,WAAAA,QAAA;MACAC,OAAA,CAAAC,GAAA;MACA,SAAAL,MAAA,UAAAM,IAAA;QACA,KAAAJ,iBAAA;MACA;MACA,KAAAK,MAAA,CAAAC,MAAA,iBAAAR,MAAA;IACA;IACAS,SAAA,WAAAA,UAAAC,IAAA;MACA,iBAAAJ,IAAA,OAAAA,IAAA,EAAAI,IAAA;IACA;EACA;EACAC,QAAA,EAAAC,aAAA,KACAhB,QAAA;AAEA"},"metadata":{},"sourceType":"module","externalDependencies":[]}